{
  "layer": "top",
  "position": "top",
  "modules-left": ["hyprland/workspaces"],
  "modules-center": [],
  "debug": true,
  "modules-right": ["custom/ip", "tray", "pulseaudio", "clock#local", "clock#utc", "cffi/waybar-eyes"],
  "cffi/waybar-eyes": {
	"eye":	{
		"iris_color":	"#4C7FCC",
		"outline_color":	"#666666"
	},
        "laser": {
		"cutout_enabled":	true
	},

	"effects":	{
		"interval":	3,
		"blink":	75,
		"stare":	5,
		"glasses_wiggle":	3,
		"raise_brows":	5,
		"brow_wiggle":	3,
		"roll_eyes":	4,
		"look_silly":	5
	},
	"targets":	{
		"enabled":	true,
		"spawn_rate":	0.65,
		"max_alive":	6,
		"mosquito":	70,
		"balloon":	25,
		"moon":	3,
		"ufo":	15
	},
	"search":	3,

      "module_path": "/home/alex/Downloads/bareyes/bin/bareyes.so",
  },
  "hyprland/workspaces": {
    "format": "{icon}",
    "on-scroll-up": "hyprctl dispatch workspace e-1",
    "on-scroll-down": "hyprctl dispatch workspace e+1",
    "format-icons": {
      "1": "",
      "2": "",
      "3": "",
      "4": "",
      "5": "",
      "6": "",
      "7": "",
      "8": "",
    },
    "disable-scroll": false,
    "persistent-workspaces": {
      "*": [1, 2, 3, 4, 5, 6, 7, 8]
    }
  },

  "tray": { "spacing": 6 },

  "pulseaudio": {
    "format": "{volume}% 🔈",
    "format-muted": "muted 🔇",
    "scroll-step": 1
  },

  "clock#local": {
    "format": "| {:%a %Y-%m-%d %H:%M:%S} |",
    "tooltip-format": "{:%A, %d %B %Y}",
    "interval": 5
  },

  "clock#utc": {
    "format": "UTC {:%H:%M:%S}",
    "tooltip-format": "{:%Y-%m-%d %H:%M:%S %Z}",
    "interval": 5,
    "timezone": "UTC"
  },

  "custom/ip": {
    "format": "IP: {} |",
    "tooltip": false,
    "interval": 10,
    "exec": "ip -4 addr show dev $(ip route get 1.1.1.1 | grep -o 'dev [^ ]*' | cut -d' ' -f2) | grep -oP '(?<=inet\\s)\\d+(\\.\\d+){3}' | head -n1"
  }
}
