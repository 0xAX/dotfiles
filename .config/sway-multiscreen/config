#
# My sway configuration file
#
# Feel free to reuse and enjoy (0xAX)
#

client.focused          #eee8d5 #fdf6e3 #073642 #8b3626
client.unfocused        #eee8d5 #eee8d5 #839496 #8b3626

# Let's use Alt for mode key
set $mod Mod1
# default font
font pango:FiraCode, FontAwesome 13

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

bindsym $mod+Shift+f floating toggle

# start a terminal
bindsym $mod+Return exec terminator --profile alex
# kill focused window
bindsym $mod+q kill
# reload the config
bindsym $mod+c reload
# start dmenu (a program launcher) -- always on the small screen, see the script
bindsym $mod+d exec ~/.local/bin/dmenu-right
# go to the next workspace
bindsym $mod+Tab workspace next
# go to the prevoious workspace
bindsym $mod+BackSpace workspace prev

# Exit from sway
bindsym $mod+Shift+e exit

# Move between sway windows
bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down

# Rotate within the current screen instead of falling off it
focus_wrapping workspace

# layouts
bindsym $mod+f fullscreen
bindsym $mod+s layout stacking
bindsym $mod+t layout tabbed
bindsym $mod+v layout splitv
bindsym $mod+h layout splith

# set default layout to tabbed
workspace_layout tabbed

# hide borders
hide_edge_borders both

# AOC U32G3X 32" 4K, physically on the LEFT  -> emacs only
set $big   DP-1
# AOC 2757   27" FHD, physically on the RIGHT -> everything else
set $small HDMI-A-3

# Place the screens: `output <name> <setting> <value>`. Here we set only the
# position - the x,y of the screen's top-left corner on one shared desktop.
#
#     x=0              x=3840
#      +------------------+                y=0
#      |                  |
#      |                  +------------+   y=540
#      |       DP-1       |  HDMI-A-3  |
#      |    3840 x 2160   | 1920 x 1080|
#      |                  +------------+   y=1620
#      |                  |
#      +------------------+                y=2160
#
# y grows downward, so y=540 leaves 540 empty above the small screen and 540
# below it - 540 + 1080 + 540 = 2160 - so the middles of both screens line
# up, the way they really stand on the desk.
#
# We do not set `mode` (resolution and refresh rate): both screens already
# start at what we want, 4K@60 and FHD@60, and setting it here crashed sway.
output $big position 0 0
output $small position 3840 540

# Re-assert the above one output at a time, because applying both in a
# single atomic commit fails on this machine.
exec_always --no-startup-id ~/.config/sway/layout.py

#
# workspaces
#
set $tag1 "1:&#xf120;"
set $tag2 "2:&#xf121;"
set $tag3 "3:&#xf269;"
set $tag4 "4:&#xf2c6;"
set $tag5 "5:&#xf0e0;"
set $tag6 "6:&#xf15b;"
set $tag7 "7:&#xf1c1;"
set $tag8 "8:&#xf02d;"

# workspace 2 is the emacs workspace and lives alone on the big screen,
# every other workspace is pinned to the small one
workspace $tag2 output $big
workspace $tag1 output $small
workspace $tag3 output $small
workspace $tag4 output $small
workspace $tag5 output $small
workspace $tag6 output $small
workspace $tag7 output $small
workspace $tag8 output $small

bindsym $mod+1 workspace $tag1
bindsym $mod+2 exec --no-startup-id ~/.config/sway/emacs.pl
bindsym $mod+3 workspace $tag3
bindsym $mod+4 workspace $tag4
bindsym $mod+5 workspace $tag5
bindsym $mod+6 workspace $tag6
bindsym $mod+7 workspace $tag7
bindsym $mod+8 workspace $tag8

bindsym $mod+Shift+1 move container to workspace $tag1
bindsym $mod+Shift+2 move container to workspace $tag2
bindsym $mod+Shift+3 move container to workspace $tag3
bindsym $mod+Shift+4 move container to workspace $tag4
bindsym $mod+Shift+5 move container to workspace $tag5
bindsym $mod+Shift+6 move container to workspace $tag6
bindsym $mod+Shift+7 move container to workspace $tag7
bindsym $mod+Shift+8 move container to workspace $tag8

#
# emacs owns the big screen
#
# emacs always lands on the emacs workspace, wherever it was started from.
# $tag2 is pinned to $big above, so that is all it takes to keep emacs on the
# big screen. Since every other workspace is pinned to $small, everything
# else stays on the small one without needing a rule of its own.
for_window [class="^[eE]macs$"] move container to workspace $tag2
for_window [app_id="^[eE]macs$"] move container to workspace $tag2

# no window decoration on emacs
for_window [class="^[eE]macs$"] border none
for_window [app_id="^[eE]macs$"] border none

bar {
        colors {
           background #eee8d5
           statusline #002b36
           separator  #eee8d5
           # Type              border   bg      fg
           focused_workspace  #eee8d5 #fdf6e3 #002b36
           # `active' is a workspace still visible on an output but without the
           # focus - which is what the small screen's workspace becomes the
           # moment focus moves to emacs on the big one. The text here used to
           # be #ffffff, i.e. white on the #eee8d5 cream background, so the
           # label just vanished. base01 keeps it readable and still distinct
           # from both focused (base03, darker) and inactive (grey, lighter).
           active_workspace   #eee8d5 #eee8d5 #586e75
           inactive_workspace #eee8d5 #eee8d5 #888888
           urgent_workspace   #eee8d5 #eee8d5 #888888
    }
    # keep the status bar off the emacs screen
    output $small
    tray_output primary
    position top
    status_command i3status -c ~/.config/sway/swaystatus.conf
    strip_workspace_numbers no
}

# resizing
bindsym $mod+r mode "resize"
mode "resize" {
    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

# lock screen
bindsym $mod+Control+l exec swaylock --tiling --color 000000

mode "passthrough" {
    bindsym $mod+Escape mode "default"
}

# sound
bindsym $mod+0 exec "amixer set Master  -q 1%+"
bindsym $mod+9 exec "amixer set Master -q 1%-"
bindsym $mod+u exec "amixer -q sset Master toggle"

# brightness
bindsym XF86MonBrightnessUp exec brightnessctl s 1%-
bindsym XF86MonBrightnessDown exec brightnessctl s 1%+

# set keyboard layout switching
input "type:keyboard" {
    xkb_layout pl,ru
    xkb_options grp:lwin_toggle
}

# Set wallpapers
output "*" bg ~/dev/dotfiles/wallpapers/solarized-dark-wallpaper.jpg fill
