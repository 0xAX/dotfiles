#!/bin/bash

set -o errexit
set -o nounset
set -o pipefail

shopt -u dotglob

# Check command line arguments
if [[ $# -ne 1 ]]; then
    echo "Error: provide command: --update-repo or --update-system"
    exit -1
fi

# Path to the dotfiles repository
DOTFILES="$HOME/dev/dotfiles"

# Path to the Firefox profile directory
MOZILA_PROFILE_DIR=$(
    awk '/^\[Profile[0-9]+\]$/ { section = $0 }
         /^Default=1$/ { print section }
         /^Path=/ && section { path = $0 }
         /^Default=1$/ && path { print path; exit }' ~/.mozilla/firefox/profiles.ini | grep '^Path=' | cut -d= -f2)
MOZILA_PROFILE_DIR="$HOME/.mozilla/firefox/$MOZILA_PROFILE_DIR"
# Path to the Firefox user themes
MOZILA_PROFILE_CSS_DIR="$MOZILA_PROFILE_DIR"/chrome
# Path to the Firefox extensions directory
MOZILA_EXTENSIONS_DIR="$MOZILA_PROFILE_DIR"/extensions

case $1 in
--update-repo)
    # Copy firefox settings
    test -f "$MOZILA_PROFILE_DIR"/user.js && cp -r "$MOZILA_PROFILE_DIR"/user.js "$DOTFILES"/firefox
    test -f "$MOZILA_PROFILE_CSS_DIR"/userChrome.css && cp -r "$MOZILA_PROFILE_CSS_DIR"/userChrome.css "$DOTFILES"/firefox/css

    # Copy mail scripts and configuration
    test -f "$HOME"/.neomutrc && cp -r "$HOME"/.neomutrc "$DOTFILES"/mail
    test -f "$HOME"/.offlineimaprc && cp -r "$HOME"/.offlineimaprc "$DOTFILES"/mail
    test -d "$HOME"/.mail && cp -r "$HOME"/.mail "$DOTFILES"/mail

    # Copy .bashrc and related stuff
    test -d "$HOME"/bin && cp -r "$HOME"/bin "$DOTFILES"/shell
    test -d "$HOME"/.bash && cp -r "$HOME"/.bash "$DOTFILES"/shell
    test -f "$HOME"/.bashrc && cp -r "$HOME"/.bashrc "$DOTFILES"/shell
    test -f "$HOME"/.bash_logout && cp -r "$HOME"/.bash_logout "$DOTFILES"/shell
    test -f "$HOME"/.bash_profile && cp -r "$HOME"/.bash_profile "$DOTFILES"/shell

    # Copy readline configuration. Not bash specific: it is picked up by
    # everything linked against readline, but what it configures is how a
    # prompt reads input, so it lives next to the shell files.
    test -r "$HOME"/.inputrc && cp -r "$HOME"/.inputrc "$DOTFILES"/shell

    # Copy emacs directories
    test -f "$HOME"/.emacs && cp -r "$HOME"/.emacs "$DOTFILES"/emacs
    test -d "$HOME"/.emacscore && cp -r "$HOME"/.emacscore "$DOTFILES"/emacs

    # Copy k9s configuration
    test -d "$HOME"/.config/k9s && cp -r "$HOME"/.config/k9s "$DOTFILES"/.config

    # Copy i3 stuff
    test -d "$HOME"/.config/i3 && cp -r "$HOME"/.config/i3/* "$DOTFILES"/.config/i3

    # Copy sway stuff
    test -d "$HOME"/.config/sway && cp -r "$HOME"/.config/sway/* "$DOTFILES"/.config/sway

    # Copy hyprland stuff
    test -d "$HOME"/.config/hypr && cp -r "$HOME"/.config/hypr/* "$DOTFILES"/.config/hypr
    test -d "$HOME"/.config/wofi && cp -r "$HOME"/.config/wofi/* "$DOTFILES"/.config/wofi
    test -d "$HOME"/.config/waybar && cp -r "$HOME"/.config/waybar/* "$DOTFILES"/.config/waybar

    # Copy lisp/sbcl configuration
    test -r "$HOME"/.sbclrc && cp -r "$HOME"/.sbclrc "$DOTFILES"/dev/

    # Copy zig/zls related files
    test -r "$HOME"/.config/zls.json && cp -r "$HOME"/.config/zls.json "$DOTFILES"/.config

    # Copy gnupg related files
    test -r "$HOME"/.gnupg/public.key && cp -r "$HOME"/.gnupg/public.key "$DOTFILES"/.gnupg
    test -r "$HOME"/.gnupg/gpg-agent.conf && cp -r "$HOME"/.gnupg/gpg-agent.conf "$DOTFILES"/.gnupg
    test -r "$HOME"/.gnupg/gpg.conf && cp -r "$HOME"/.gnupg/gpg.conf "$DOTFILES"/.gnupg
    test -r "$HOME"/.gnupg/dirmngr.conf && cp -r "$HOME"/.gnupg/dirmngr.conf "$DOTFILES"/.gnupg

    # Copy terminator stuff
    test -r "$HOME"/.config/terminator/config && cp -r "$HOME"/.config/terminator/config  "$DOTFILES"/.config/terminator

    # Copy X files
    test -r "$HOME"/.Xresources && cp -r "$HOME"/.Xresources "$DOTFILES"/system/
    test -r "$HOME"/.xinitrc && cp -r "$HOME"/.xinitrc "$DOTFILES"/system/

    # Copy init files of the development tools. Both are read by the tool
    # itself on startup, so they live in dev/ next to .sbclrc.
    test -r "$HOME"/.gdbinit && cp -r "$HOME"/.gdbinit "$DOTFILES"/dev
    test -r "$HOME"/.pythonrc && cp -r "$HOME"/.pythonrc "$DOTFILES"/dev

    # Copy prettier configuration. Prettier looks for it next to the file it
    # formats and walks up to $HOME, so it has to be installed there.
    test -r "$HOME"/.prettierrc && cp -r "$HOME"/.prettierrc "$DOTFILES"/dev

    # Copy git configuration
    test -r "$HOME"/.gitconfig && cp -r "$HOME"/.gitconfig "$DOTFILES"/git
    test -r "$HOME"/.gitignore_global && cp -r "$HOME"/.gitignore_global "$DOTFILES"/git

    # Copy tmux configuration
    test -r "$HOME"/.tmux.conf && cp -r "$HOME"/.tmux.conf "$DOTFILES"/tmux

    ;;
--update-system)
    # Copy mail scripts and configuration
    cp -r "$DOTFILES"/mail/.mail "$HOME"/
    cp -r "$DOTFILES"/mail/.neomutrc "$HOME"/
    cp -r "$DOTFILES"/mail/.offlineimaprc "$HOME"/
    sudo cp -r "$DOTFILES"/mail/email "$DOTFILES"/mail/sync-email /usr/local/bin

    # Copy lisp/sbcl configuration
    command -v sbcl && cp -r "$DOTFILES"/dev/.sbclrc "$HOME"/.sbclrc

    # Copy zig/zls related files
    test -x "$HOME/disk/dev/zig/zig" && cp -r "$DOTFILES"/.config/zls.json "$HOME"/.config/

    # Copy gnupg related files. gpg insists on 700 on its home directory,
    # otherwise it warns about unsafe permissions on every invocation.
    mkdir -p "$HOME"/.gnupg && chmod 700 "$HOME"/.gnupg
    cp -r "$DOTFILES"/.gnupg/*.conf "$DOTFILES"/.gnupg/public.key "$HOME"/.gnupg/

    # Copy init files of the development tools. Unlike .sbclrc above these
    # are copied unconditionally, gdb and python are always around.
    cp -r "$DOTFILES"/dev/{.gdbinit,.pythonrc} "$HOME"/

    # Copy prettier configuration. Prettier looks for it next to the file it
    # formats and walks up to $HOME, so it has to be installed there.
    cp -r "$DOTFILES"/dev/.prettierrc "$HOME"/

    # Copy git configuration. The trailing dot copies the directory content
    # instead of the directory itself, so both .gitconfig and .gitignore_global.
    cp -r "$DOTFILES"/git/. "$HOME"/

    # Copy tmux configuration
    cp -r "$DOTFILES"/tmux/.tmux.conf "$HOME"/

    # Copy emacs files
    rm -rf "$HOME"/{.emacs,.emacscore}
    cp -r emacs/.emacs emacs/.emacscore "$HOME"/

    # Copy k9s configurations
    mkdir -p "$HOME"/.config/k9s
    cp -r "$DOTFILES"/.config/k9s/* "$HOME"/.config/k9s
    
    # Copy i3 stuff
    mkdir -p "$HOME"/.config/i3
    cp -r "$DOTFILES"/.config/i3/* "$HOME"/.config/i3

    # Copy sway stuff
    mkdir -p "$HOME"/.config/sway
    cp -r "$DOTFILES"/.config/sway/* "$HOME"/.config/sway

    # Copy hyprland stuff
    mkdir -p "$HOME"/.config/{hypr,wofi,waybar}
    cp -r "$DOTFILES"/.config/hypr/* "$HOME"/.config/hypr/
    cp -r "$DOTFILES"/.config/wofi/* "$HOME"/.config/wofi/
    cp -r "$DOTFILES"/.config/waybar/* "$HOME"/.config/waybar/

    # Copy terminator stuff
    mkdir -p "$HOME"/.config/terminator && cp -r "$DOTFILES"/.config/terminator/* "$HOME"/.config/terminator

    # Copy the shell files to the home directory. The trailing dot copies the
    # directory content instead of the directory itself, so .bashrc, .bash/,
    # .bash_profile, .bash_logout and .inputrc all go in one command.
    cp -r "$DOTFILES"/shell/. "$DOTFILES/shell/bin" "$HOME"/

    # Copy system (per-user) files
    cp -r "$DOTFILES"/system/{.Xresources,.xinitrc} "$HOME"/

    # Copy firefox settings
    cp -r "$DOTFILES"/firefox/user.js "$MOZILA_PROFILE_DIR"/
    mkdir -p "$MOZILA_PROFILE_CSS_DIR"/ && cp -r "$DOTFILES"/firefox/css/*.css "$MOZILA_PROFILE_CSS_DIR"/

    # Install bin scripts
    "$HOME"/bin/installScripts
    ;;
*)
    echo "Error: provide command: --update-repo or --update-system"
    exit -1
    ;;
esac

echo -e "\e[32mDone.\e[39m"
